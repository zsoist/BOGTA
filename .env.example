# Copy to .env and paste your key from platform.claude.com (Build Day credits)
ANTHROPIC_API_KEY=
# Only for user-scoped keys (sk-ant-usr-…): workspace ID from Console → Settings → Workspaces
ANTHROPIC_WORKSPACE_ID=
# Model for NPC dialogue + radio DJ (Opus 5.5 default)
CLAUDE_MODEL=claude-opus-5-5
PORT=5173

# ElevenLabs key for music/voices/SFX (elevenlabs.io)
ELEVENLABS_API_KEY=

# Atlas Cloud key for AI video clips (atlascloud.ai)
ATLASCLOUD_API_KEY=
